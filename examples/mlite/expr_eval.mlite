#lang mlite
# expr_eval.mlite — evaluate a small arithmetic AST to Result values.
# `Result` comes from std/result.mlite, which imports std/option.mlite; this
# file imports option too (a diamond). `cube` goes through the Stage-1
# `fast_pow`, which unrolls the constant exponent.
import "std/result.mlite";
import "std/option.mlite";
import "std/assert.mlite";

fun cube(x) = fast_pow(x, 3);

type Expr =
    Lit(n)
  | Add(lhs, rhs)
  | Mul(lhs, rhs)
  | Div(lhs, rhs)
  | Cube(base);

fun eval_expr(e) =
  case e of
    Lit(n)    => Ok(n)
  | Add(l, r) =>
      case eval_expr(l) of
        Err(m) => Err(m)
      | Ok(lv) =>
          case eval_expr(r) of
            Err(m) => Err(m)
          | Ok(rv) => Ok(lv + rv)
          end
      end
  | Mul(l, r) =>
      eval_expr(l) |> and_then(fn (lv) =>
      eval_expr(r) |> map_ok(fn (rv) => lv * rv))
  | Div(l, r) =>
      eval_expr(r) |> and_then(fn (rv) =>
      eval_expr(l) |> and_then(fn (lv) => safe_div(lv, rv)))
  | Cube(b) => eval_expr(b) |> map_ok(cube)
  end;

fun show_int(v) = int_to_str(v);

fun report(name, e) =
  println(str_concat(str_concat(name, " = "), e |> eval_expr |> show_result(show_int)));

val prog = Add(Mul(Lit(3), Lit(10)), Div(Lit(24), Lit(2)));
report("3 * 10 + 24 / 2", prog);
report("cube(2 + 1)", Cube(Add(Lit(2), Lit(1))));
report("7 / (1 - 1)", Div(Lit(7), Add(Lit(1), Mul(Lit(- 1), Lit(1)))));
report("1 + 5 / 0", Add(Lit(1), Div(Lit(5), Lit(0))));

var fallbacks = 0;
fun fallback() = do fallbacks := fallbacks + 1; 0 end;
val total =
  (prog |> eval_expr |> ok_opt |> unwrap_or(0))
  + ok_or(Div(Lit(1), Lit(0)) |> eval_expr, fallback())
  + ok_or(prog |> eval_expr, fallback());
println(str_concat("fallbacks: ", int_to_str(fallbacks)));
assert(total == 84, "total is 84");
total
