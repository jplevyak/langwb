#lang mlite
# expr_eval.mlite — evaluate a small arithmetic AST to Result values.
# (Result is declared inline until `std/result.mlite` (M3); the Stage-1
# `fast_pow` arrives in M4.)

type Result = Ok(val) | Err(msg);

type Expr =
    Lit(n)
  | Add(lhs, rhs)
  | Mul(lhs, rhs)
  | Div(lhs, rhs)
  | Cube(base);

fun eval_expr(e) =
  case e of
    Lit(n)    => Ok(n)
  | Add(l, r) =>
      case eval_expr(l) of
        Err(m) => Err(m)
      | Ok(lv) =>
          case eval_expr(r) of
            Err(m) => Err(m)
          | Ok(rv) => Ok(lv + rv)
          end
      end
  | Mul(l, r) =>
      case eval_expr(l) of
        Err(m) => Err(m)
      | Ok(lv) =>
          case eval_expr(r) of
            Err(m) => Err(m)
          | Ok(rv) => Ok(lv * rv)
          end
      end
  | Div(l, r) =>
      case eval_expr(r) of
        Err(m) => Err(m)
      | Ok(rv) =>
          if rv == 0 then Err("division by zero")
          else
            case eval_expr(l) of
              Err(m) => Err(m)
            | Ok(lv) => Ok(lv / rv)
            end
      end
  | Cube(b) =>
      case eval_expr(b) of
        Err(m) => Err(m)
      | Ok(bv) => Ok(bv * bv * bv)
      end
  end;

fun show_result(r) =
  case r of
    Ok(v)  => str_concat("Ok ", int_to_str(v))
  | Err(m) => str_concat("Err ", m)
  end;

fun unwrap_ok_or(r, d) =
  case r of
    Ok(v)  => v
  | Err(_) => d
  end;

fun report(name, e) = println(str_concat(str_concat(name, " = "), e |> eval_expr |> show_result));

val prog = Add(Mul(Lit(3), Lit(10)), Div(Lit(24), Lit(2)));
report("3 * 10 + 24 / 2", prog);
report("cube(2 + 1)", Cube(Add(Lit(2), Lit(1))));
report("7 / (1 - 1)", Div(Lit(7), Add(Lit(1), Mul(Lit(- 1), Lit(1)))));
report("1 + 5 / 0", Add(Lit(1), Div(Lit(5), Lit(0))));
(prog |> eval_expr |> unwrap_ok_or(0)) + (Div(Lit(1), Lit(0)) |> eval_expr |> unwrap_ok_or(0))
