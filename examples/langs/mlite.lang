# mlite.lang — MLite, a small ML-family language written with zero C++.
#
# Step 11 dogfood language (see docs/STEP11_DOGFOOD_LANG.md). The minilang
# `expr` and `stmt` grammars are *replaced* (`:=`), so every declaration after
# the `grammar { ... }` block below is written in MLite itself.
#
# Milestone M0: `val` / `fun` / `fn` / `let ... in ... end` / `if` / calls /
# arithmetic and comparisons.

grammar {
  expr := 'fn' '(' params? ')' '=>' expr                            $right 0 core(lambda, bind=2, body=5)
        | 'if' expr 'then' expr 'else' expr                         $right 0 core(if, test=1, then=3, else=5)
        | 'let' 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr 'in' expr 'end'      core(let, bind=2, rhs=4, body=6)
        | 'let' 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs 'in' expr 'end'       core(letrec, bind=2, rhs=3, body=5)
        | expr '==' expr                                            $left 4  core(binop, lhs=0, op=1, rhs=2)
        | expr '!=' expr                                            $left 4  core(binop, lhs=0, op=1, rhs=2)
        | expr '<' expr                                             $left 5  core(binop, lhs=0, op=1, rhs=2)
        | expr '<=' expr                                            $left 5  core(binop, lhs=0, op=1, rhs=2)
        | expr '>' expr                                             $left 5  core(binop, lhs=0, op=1, rhs=2)
        | expr '>=' expr                                            $left 5  core(binop, lhs=0, op=1, rhs=2)
        | expr '+' expr                                             $left 6  core(binop, lhs=0, op=1, rhs=2)
        | expr '-' expr                                             $left 6  core(binop, lhs=0, op=1, rhs=2)
        | expr '*' expr                                             $left 7  core(binop, lhs=0, op=1, rhs=2)
        | expr '/' expr                                             $left 7  core(binop, lhs=0, op=1, rhs=2)
        | expr '(' args ')'                                         $left 10 core(app, fn=0, args=2)
        | expr '(' ')'                                              $left 10 core(app, fn=0)
        | '(' expr ')'                                                       core(paren, inner=1)
        | "\"([^\"\\]|\\[^])*\""                                             core(string)
        | "[0-9]+"                                                           core(datum)
        | "[a-zA-Z_][a-zA-Z0-9_]*"                                           core(ident);
  stmt := 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr                  $right 0 core(define, bind=1, rhs=3)
        | 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs                            core(define, bind=1, rhs=2)
        | expr                                                               core(passthrough, inner=0);
  fun_rhs : '(' params? ')' '=' expr                                $right 0 core(lambda, bind=1, body=4);
};
