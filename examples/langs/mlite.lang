# mlite.lang — MLite, a small ML-family language written with zero C++.
#
# Step 11 dogfood language (see docs/STEP11_DOGFOOD_LANG.md). The minilang
# `expr` and `stmt` grammars are *replaced* (`:=`), so every declaration after
# the `grammar { ... }` block below is written in MLite itself.
#
# M0: `val` / `fun` / `fn` / `let ... in ... end` / `if` / calls / arithmetic
#     and comparisons.
# M1: `case e of Pat => e | ... end` over `type` ADTs, integers, and variables.
# M2: `var` / `:=` / `while` / `for` / `do ... end` / `|>` / `and` / `or` /
#     `not` / unary `-` / `%`, records and field mutation.
# M3: no new syntax; `import "x.mlite";` / `export a, b;` are workbench
#     declarations. The stdlib is examples/mlite/std/{option,result,list}.mlite.
# M4: Stage-1 `fast_pow`, `check call safe_div` / `assert` (their runtime
#     halves are in std/result.mlite and std/assert.mlite), C prims, a
#     `module_begin` hook, and `using syntax power in { a ** b }`.
# M5: multi-binding `let val x = 1; fun f(y) = ... in ... end` and
#     `unless c do ... end` (Step 11 cleanup; AOT and LSP need no syntax).

grammar {
  expr := 'fn' '(' params? ')' '=>' expr                            $right 0 core(lambda, bind=2, body=5)
        | 'if' expr 'then' expr 'else' expr                         $right 0 core(if, test=1, then=3, else=5)
        | 'let' 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr 'in' expr 'end'      core(let, bind=2, rhs=4, body=6)
        | 'let' 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs 'in' expr 'end'       core(letrec, bind=2, rhs=3, body=5)
        | expr eq_op expr                                                    core(binop, lhs=0, op=1, rhs=2)
        | expr rel_op expr                                                   core(binop, lhs=0, op=1, rhs=2)
        | expr add_op expr                                                   core(binop, lhs=0, op=1, rhs=2)
        | expr mul_op expr                                                   core(binop, lhs=0, op=1, rhs=2)
        | expr '(' args ')'                                         $left 10 core(app, fn=0, args=2)
        | expr '(' ')'                                              $left 10 core(app, fn=0)
        | '(' expr ')'                                                       core(paren, inner=1)
        | "\"([^\"\\]|\\[^])*\""                                             core(string)
        | "[0-9]+"                                                           core(datum)
        | "[a-zA-Z_][a-zA-Z0-9_]*"                                           core(ident);
  stmt := 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr                  $right 0 core(define, bind=1, rhs=3)
        | 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs                            core(define, bind=1, rhs=2)
        | expr                                                               core(passthrough, inner=0);
  # Binary operators use DParser operator priorities on 1-token operator
  # productions (not rule-level `$left N`), so they group correctly against
  # the macro-lowered operators added in M2 (FL-2).
  eq_op  : '==' $binary_op_left 4 | '!=' $binary_op_left 4;
  rel_op : '<' $binary_op_left 5 | '<=' $binary_op_left 5 | '>' $binary_op_left 5 | '>=' $binary_op_left 5;
  add_op : '+' $binary_op_left 6 | '-' $binary_op_left 6;
  mul_op : '*' $binary_op_left 7 | '/' $binary_op_left 7 | '%' $binary_op_left 7;
  fun_rhs : '(' params? ')' '=' expr                                $right 0 core(lambda, bind=1, body=4);
};

# ---------------------------------------------------------------------------
# M1: `case ... of ... end`
#
# Patterns: `Ctor`, `Ctor(x, _, y)`, integer literals, a variable, or `_`.
# Constructors and variables are told apart lexically (`[A-Z]...` vs
# `[a-z_]...`), which is unambiguous because the pattern regexes only apply in
# pattern position. Arms are `|`-separated; a nested `case` in an arm body is
# closed by its own `end`.
grammar {
  expr += case_expr core(passthrough);
  case_expr    : 'case' expr 'of' case_arms 'end';
  case_arms    : case_arm ('|' case_arm)*;
  case_arm     : case_pat '=>' expr;
  case_pat     : pat_int | pat_ctor | pat_ctor_app | pat_var;
  pat_int      : "[0-9]+";
  pat_ctor     : "[A-Z][a-zA-Z0-9_]*";
  pat_ctor_app : "[A-Z][a-zA-Z0-9_]*" '(' pat_vars ')';
  pat_vars     : pat_var | pat_var ',' pat_vars;
  pat_var      : "[a-z_][a-zA-Z0-9_]*";
};

# Phase-1 helpers (written in MLite). `case` lowers to
#   let val __m__ = scrut in
#     if <arm 1 test> then <arm 1 body> else ... else wb_match_fail()
#   end
# using the workbench's ADT primitives `__wb_is_variant(m, "C", arity, "shown")`
# and `__wb_variant_field(m, "C", i)`.
for_syntax cat3 => fn (a, b, c) => str_concat(str_concat(a, b), c);
for_syntax case_q => fn (s) => cat3("\"", s, "\"");

# Points the `__wb_is_variant` test of an `if` template at the pattern's
# constructor, so arity / unknown-variant errors report the user's pattern.
for_syntax case_at => fn (tmpl, loc) =>
  let val t = stx_copy_loc(stx_child(tmpl, 1), loc) in tmpl end;

for_syntax case_count_vars => fn (pv) =>
  if stx_num_children(pv) == 3 then 1 + case_count_vars(stx_child(pv, 2)) else 1;

for_syntax case_shown_vars => fn (pv) =>
  if stx_num_children(pv) == 3
  then cat3(stx_text(stx_child(pv, 0)), ", ", case_shown_vars(stx_child(pv, 2)))
  else stx_text(stx_child(pv, 0));

# Wraps `acc` in `let val v_i = __wb_variant_field(__m__, "C", i) in ... end`
# for each non-`_` pattern variable.
for_syntax case_bind_vars => fn (pv, ctor, i, acc) =>
  let val v = stx_child(stx_child(pv, 0), 0) in
    let val wrapped =
      if stx_text_eq(v, "_") == 1 then acc
      else stx_splice(
             stx_splice(
               stx_parse("expr", cat3("let val __v__ = __wb_variant_field(__m__, ", case_q(ctor),
                                      cat3(", ", int_to_str(i), ") in __b__ end"))),
               "__v__", v),
             "__b__", acc)
    in
      if stx_num_children(pv) == 3
      then case_bind_vars(stx_child(pv, 2), ctor, i + 1, wrapped)
      else wrapped
    end
  end;

# Lowers one arm in front of `acc` (the lowering of the arms after it).
for_syntax case_arm_lower => fn (arm, acc) =>
  let val p = stx_child(stx_child(arm, 0), 0) in
  let val body = stx_child(arm, 2) in
    if stx_symbol_eq(p, "pat_int") == 1 then
      stx_splice(
        stx_splice(
          stx_splice(stx_parse("expr", "if __m__ == __k__ then __b__ else __n__"),
                     "__k__", stx_parse("expr", stx_text(stx_child(p, 0)))),
          "__b__", body),
        "__n__", acc)
    else if stx_symbol_eq(p, "pat_var") == 1 then
      if stx_text_eq(stx_child(p, 0), "_") == 1 then body
      else stx_splice(
             stx_splice(stx_parse("expr", "let val __v__ = __m__ in __b__ end"),
                        "__v__", stx_child(p, 0)),
             "__b__", body)
    else if stx_symbol_eq(p, "pat_ctor") == 1 then
      stx_splice(
        stx_splice(
          case_at(stx_parse("expr", cat3("if __wb_is_variant(__m__, ", case_q(stx_text(stx_child(p, 0))),
                                         ", 0) then __b__ else __n__")),
                  stx_child(p, 0)),
          "__b__", body),
        "__n__", acc)
    else
      let val ctor = stx_text(stx_child(p, 0)) in
      let val pv = stx_child(p, 2) in
      let val shown = cat3(ctor, "(", cat3(case_shown_vars(pv), ")", "")) in
        stx_splice(
          stx_splice(
            case_at(
              stx_parse("expr",
                cat3(cat3("if __wb_is_variant(__m__, ", case_q(ctor), ", "),
                     cat3(int_to_str(case_count_vars(pv)), ", ", case_q(shown)),
                     ") then __b__ else __n__")),
              stx_child(p, 0)),
            "__b__", case_bind_vars(pv, ctor, 0, body)),
          "__n__", acc)
      end end end
  end end;

# Right-to-left fold over the arms under `n` (children `i` down to 0). Stops at
# each `case_arm`, so a nested `case` inside an arm body is left to its own
# expansion.
for_syntax case_fold => fn (n, i, acc) =>
  if stx_symbol_eq(n, "case_arm") == 1 then case_arm_lower(n, acc)
  else if i < 0 then acc
  else case_fold(n, i - 1,
                 case_fold(stx_child(n, i), stx_num_children(stx_child(n, i)) - 1, acc));

form_macro case_expr =>
  let val c = stx_call() in
  let val arms = stx_child(c, 3) in
    stx_splice(
      stx_splice(stx_parse("expr", "let val __m__ = __s__ in __body__ end"),
                 "__s__", stx_child(c, 1)),
      "__body__",
      case_fold(arms, stx_num_children(arms) - 1, stx_parse("expr", "wb_match_fail()")))
  end end;

# ---------------------------------------------------------------------------
# M2: imperative forms, records, and macro-lowered operators.
#
# Operators lowered by macros live in their own non-terminal, with DParser
# operator priorities on a 1-token operator production (FL-2).
grammar {
  stmt += 'var' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr                $right 0 core(define, bind=1, rhs=3);
  expr += "[a-zA-Z_][a-zA-Z0-9_]*" ':=' expr                      $right 0 core(assign, lhs=0, rhs=2)
        | field_lhs '.' "[a-zA-Z_][a-zA-Z0-9_]*" ':=' expr        $right 0 core(set_field, obj=0, field=2, rhs=4)
        | 'while' expr 'do' block 'end'                                    core(while, test=1, body=3)
        | 'do' stmts 'end'                                                 core(seq, inner=1)
        | '{' fields '}'                                                   core(record, fields=1)
        | expr '.' "[a-zA-Z_][a-zA-Z0-9_]*"                       $left 10 core(field, obj=0, field=2)
        | for_e  core(passthrough)
        | pipe_e core(passthrough)
        | or_e   core(passthrough)
        | and_e  core(passthrough)
        | not_e  core(passthrough)
        | neg_e  core(passthrough);
  block   : stmts core(seq, inner=0);
  for_e   : 'for' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr 'to' expr 'do' block 'end';
  pipe_e  : expr pipe_op expr;   pipe_op : '|>'  $binary_op_left 1;
  or_e    : expr or_op expr;     or_op   : 'or'  $binary_op_left 2;
  and_e   : expr and_op expr;    and_op  : 'and' $binary_op_left 3;
  not_e   : not_op expr;         not_op  : 'not' $unary_op_right 8;
  neg_e   : neg_op expr;         neg_op  : '-'   $unary_op_right 8;
};

# Short-circuiting boolean operators and prefix operators.
syntax_rule form or_e($a:expr, _, $b:expr) => if $a then true else $b;
syntax_rule form and_e($a:expr, _, $b:expr) => if $a then $b else false;
syntax_rule form not_e(_, $a:expr) => if $a then false else true;
syntax_rule form neg_e(_, $a:expr) => (0 - $a);

# `for i = lo to hi do body end`: `lo` then `hi` are evaluated once, before
# the loop, in the enclosing scope (so `for i = i + 1 to ...` sees an outer
# `i`).
syntax_rule form for_e(_, $i:ident, _, $lo:expr, _, $hi:expr, _, $body:block, _) =>
  let val lo = $lo in let val hi = $hi in
    do var $i = lo; while $i <= hi do $body; $i := $i + 1 end end
  end end;

# `x |> f` is `f(x)`; `x |> f(a, b)` is `f(x, a, b)` (`x` evaluated first).
form_macro pipe_e =>
  let val c = stx_call() in
  let val x = stx_child(c, 0) in
  let val f = stx_child(c, 2) in
    if stx_is_core(f, "app") == 1 then
      if stx_num_children(f) == 4 then
        stx_splice(
          stx_splice(stx_splice(stx_parse("expr", "__f__(__x__, __a__)"), "__f__", stx_child(f, 0)),
                     "__x__", x),
          "__a__", stx_child(f, 2))
      else
        stx_splice(stx_splice(stx_parse("expr", "__f__(__x__)"), "__f__", stx_child(f, 0)), "__x__", x)
    else
      stx_splice(stx_splice(stx_parse("expr", "__f__(__x__)"), "__f__", f), "__x__", x)
  end end end;

# ---------------------------------------------------------------------------
# M4: IFA-driven Stage-1 macros, static checks, C primitives, a #lang hook,
# and a scoped syntax extension.

# `fast_pow(b, e)`: a constant exponent 0..8 (as IFA sees it at this call's
# contour) unrolls into `let val t = b in t * t * ... end` (`b` evaluated
# once); anything else becomes a runtime loop.
for_syntax pow_product => fn (t, n) =>
  if n == 1 then t
  else stx_splice(stx_splice(stx_parse("expr", "__a__ * __b__"), "__a__", t),
                  "__b__", pow_product(t, n - 1));

stage1_macro fast_pow =>
  let val c = stx_call() in
  let val b = stx_arg(c, 0) in
  let val e = stx_arg(c, 1) in
    if attr_is_const_i64(e) == 1 and attr_const_i64(e) >= 0 and attr_const_i64(e) <= 8 then
      stx_splice(
        stx_splice(stx_parse("expr", "let val t = __base__ in __body__ end"), "__base__", b),
        "__body__",
        if attr_const_i64(e) == 0 then stx_parse("expr", "1")
        else pow_product(stx_parse("expr", "t"), attr_const_i64(e)))
    else
      stx_splice(
        stx_splice(
          stx_parse("expr",
            "let val b = __base__ in let val e = __exp__ in do var r = 1; var i = 0; while i < e do r := r * b; i := i + 1 end; r end end end"),
          "__base__", b),
        "__exp__", e)
  end end end;

# `safe_div(a, b)` (std/result.mlite) is rejected when IFA proves the divisor
# is zero in any analysis contour of the call.
for_syntax zero_in_some_contour => fn (d, i, n) =>
  if i >= n then false
  else if attr_contour_is_const_i64(d, i) == 1 and attr_contour_const_i64(d, i) == 0 then true
  else zero_in_some_contour(d, i + 1, n);

check call safe_div =>
  let val d = stx_arg(stx_call(), 1) in
    if (attr_is_const_i64(d) == 1 and attr_const_i64(d) == 0)
       or zero_in_some_contour(d, 0, attr_contour_count(d)) then
      stx_error(d, "safe_div: divisor is always zero")
    else 0
  end;

# `assert(c, msg)` (std/assert.mlite) is rejected when `c` is the literal
# `false`; otherwise it is checked at run time.
check call assert =>
  let val c = stx_arg(stx_call(), 0) in
    if stx_is_ident(c) == 1 and stx_text_eq(c, "false") == 1 then
      stx_error(c, "assert: condition is always false")
    else 0
  end;

# C primitives. `abs_i` folds constant arguments at analysis time; `clock_ticks`
# (processor time, `clock()`) is impure; `exit_with` ends the process.
prim abs_i c_call "llabs" transfer =>
  if fa_arg_is_const_i64(0) == 1 then
    let val v = fa_arg_const_i64(0) in fa_emit_const_i64(if v < 0 then 0 - v else v) end
  else fa_emit_i64();
prim clock_ticks c_call "clock" transfer => fa_emit_i64();
prim exit_with c_call "exit" transfer => fa_emit_i64();

# The entry module (only) sees `mlite_version`.
hook module_begin =>
  stx_splice(
    stx_splice(stx_parse("expr", "let val __id__ = 4 in __body__ end"),
               "__id__", stx_unhygienic_id("mlite_version")),
    "__body__", stx_call());

# `using syntax power in { a ** b }`: right-associative `**` binding tighter
# than `*` and unary `-`, lowered to `fast_pow`.
grammar expr += 'using' 'syntax' "[a-zA-Z_][a-zA-Z0-9_]*" 'in' raw_block $right 0 core(using_syntax, bind=2, body=4);

syntax_ext power {
  grammar expr += pow_e core(passthrough);
  grammar pow_e : expr pow_op expr;
  grammar pow_op : '**' $binary_op_right 9;
  syntax_rule form pow_e($a:expr, _, $b:expr) => fast_pow($a, $b);
};

# ---------------------------------------------------------------------------
# M5 cleanup: multi-binding `let` and `unless`.
#
# `let val x = 1; val y = x + 1; fun f(z) = z * y in f(x) end` nests one
# `core(let)` / `core(letrec)` per binding through the right-recursive
# `let_tail`, so it needs no macro.
grammar {
  expr += 'let' 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr ';' let_tail  core(let, bind=2, rhs=4, body=6)
        | 'let' 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs ';' let_tail   core(letrec, bind=2, rhs=3, body=5)
        | unless_e core(passthrough);
  let_tail : 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr ';' let_tail       core(let, bind=1, rhs=3, body=5)
           | 'val' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr 'in' expr 'end'    core(let, bind=1, rhs=3, body=5)
           | 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs ';' let_tail        core(letrec, bind=1, rhs=2, body=4)
           | 'fun' "[a-zA-Z_][a-zA-Z0-9_]*" fun_rhs 'in' expr 'end'     core(letrec, bind=1, rhs=2, body=4);
  unless_e : 'unless' expr 'do' block 'end';
};

# `unless c do body end` runs `body` when `c` is false; its value is 0.
syntax_rule form unless_e(_, $c:expr, _, $body:block, _) =>
  if $c then 0 else do $body; 0 end;
