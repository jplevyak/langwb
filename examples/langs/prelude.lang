# prelude.lang — Complete minilang core language defined with ZERO C++ grammar rules.
# Booted on `langwb --bare` (which starts with an empty GrammarDef).

grammar {
  expr : 'let' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr 'in' expr $right 0 core(let, bind=1, rhs=3, body=5)
       | 'rec' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr 'in' expr $right 0 core(letrec, bind=1, rhs=3, body=5)
       | 'if' expr 'then' expr 'else' expr $right 0 core(if, test=1, then=3, else=5)
       | 'fn' '(' params ')' '=>' expr $right 0 core(lambda, bind=2, body=5)
       | expr '==' expr $left 1 core(binop, lhs=0, op=1, rhs=2)
       | expr '!=' expr $left 1 core(binop, lhs=0, op=1, rhs=2)
       | expr '<'  expr $left 2 core(binop, lhs=0, op=1, rhs=2)
       | expr '<=' expr $left 2 core(binop, lhs=0, op=1, rhs=2)
       | expr '>'  expr $left 2 core(binop, lhs=0, op=1, rhs=2)
       | expr '>=' expr $left 2 core(binop, lhs=0, op=1, rhs=2)
       | expr '+'  expr $left 3 core(binop, lhs=0, op=1, rhs=2)
       | expr '-'  expr $left 3 core(binop, lhs=0, op=1, rhs=2)
       | expr '*'  expr $left 4 core(binop, lhs=0, op=1, rhs=2)
       | expr '/'  expr $left 4 core(binop, lhs=0, op=1, rhs=2)
       | expr '.' "[a-zA-Z_][a-zA-Z0-9_]*" $left 5 core(field, obj=0, field=2)
       | '{' fields '}' core(record, fields=1)
       | '{' stmts '}'  core(seq, inner=1)
       | expr '(' args ')' $left 5 core(app, fn=0, args=2)
       | expr '(' ')'      $left 5 core(app, fn=0)
       | '(' expr ')' core(paren, inner=1)
       | "\"[^\"]*\"" core(string)
       | "[0-9]+" core(datum)
       | "[a-zA-Z_][a-zA-Z0-9_]*" core(ident);

  args       : expr (',' expr)*;
  params     : "[a-zA-Z_][a-zA-Z0-9_]*" (',' "[a-zA-Z_][a-zA-Z0-9_]*")*;
  fields     : field_init (',' field_init)*;
  field_init : "[a-zA-Z_][a-zA-Z0-9_]*" ':' expr;
  stmts      : stmt (';' stmt)*;
  stmt       : 'def' "[a-zA-Z_][a-zA-Z0-9_]*" '=' expr $right 0 core(define, bind=1, rhs=3)
             | expr core(passthrough, inner=0);

  # Standard syntactic sugar defined purely via syntax_rule:
  expr        += unless_expr core(passthrough, inner=0);
  unless_expr  : 'unless' expr 'then' expr 'else' expr $right 0;
};

syntax_rule form unless_expr(_ $c:expr _ $t:expr _ $e:expr) => if $c then $e else $t;
syntax_rule with_tmp($v:expr, $b:expr) => let tmp = $v in tmp + $b;
